# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Para descobrir seu username: publique qualquer prompt no LangSmith Hub, depois abra-o e clique no ícone de cadeado (🔒) para ver seu username.
USERNAME_LANGSMITH_HUB=

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GOOGLE_API_KEY=

# Ollama Local Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434

# LLM Configuration (default: local Ollama; no provider API credits required)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
EVAL_MODEL=gemma4:e4b

#LLM_PROVIDER=openai
#LLM_MODEL=gpt-4o-mini
#EVAL_MODEL=gpt-4o

# To use Google, set LLM_PROVIDER=google, choose currently available models,
# and provide GOOGLE_API_KEY.